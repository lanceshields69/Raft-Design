{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/marketing/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Noto Sans JP|Noto Serif JP|Fraunces))/i]",
        "message": "Font not provided by the design system. Available: Inter, Noto Sans JP, Noto Serif JP, Fraunces."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|wide|arrow|href|onClick|type|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, wide, arrow, href, onClick, type, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:elevated|sunken|canvas)$/]",
        "message": "<Card> tone must be one of 'elevated' | 'sunken' | 'canvas'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClientLogoMarquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:clients|theme|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<ClientLogoMarquee> doesn't accept that prop. Declared props: clients, theme, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClientLogoMarquee'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<ClientLogoMarquee> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommunityStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|icon|assetBase|href|style|key|ref|className|style|children)$/]",
        "message": "<CommunityStrip> doesn't accept that prop. Declared props: text, icon, assetBase, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|body|cta|onCta|href|style|key|ref|className|style|children)$/]",
        "message": "<CtaBanner> doesn't accept that prop. Declared props: heading, body, cta, onCta, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|primary|accent)$/]",
        "message": "<Eyebrow> tone must be one of 'muted' | 'primary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|style|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: question, answer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GraveyardRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|note|status|statusLabel|tinted|style|key|ref|className|style|children)$/]",
        "message": "<GraveyardRow> doesn't accept that prop. Declared props: name, note, status, statusLabel, tinted, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GraveyardRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:stack|rotation|watching|overhyped|dropped)$/]",
        "message": "<GraveyardRow> status must be one of 'stack' | 'rotation' | 'watching' | 'overhyped' | 'dropped'."
      },
      {
        "selector": "JSXOpeningElement[name.name='JournalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|excerpt|href|variant|linkLabel|style|key|ref|className|style|children)$/]",
