        "message": "<WorkCard> doesn't accept that prop. Declared props: image, title, href, alt, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
