        "selector": "JSXOpeningElement[name.name='ToolCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:stack|rotation|watching|overhyped|dropped)$/]",
        "message": "<ToolCard> status must be one of 'stack' | 'rotation' | 'watching' | 'overhyped' | 'dropped'."
